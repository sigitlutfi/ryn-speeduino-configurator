{
  "name": "ryn-speeduino-configurator",
  "productName": "RYN CONFIGURATOR",
  "version": "1.0.0-alpha.1",
  "description": "Modern, high-performance tuning interface for Speeduino ECUs with real-time analytics and 3D visualization.",
  "main": ".vite/build/index.cjs",
  "private": false,
  "packageManager": "bun@1.4.0",
  "engines": { "node": ">=24.0.0", "bun": ">=1.4.0" },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "test:package": "node scripts/verify-package.mjs",
    "build:renderer": "vite build --config vite.renderer.config.mjs --outDir .cache/upgrade-renderer",
    "upgrade:check": "node scripts/upgrade-check.mjs",
    "upgrade:sync": "node scripts/upgrade-check.mjs --sync",
    "start": "node scripts/forge.mjs start",
    "package": "node scripts/forge.mjs package",
    "make": "node scripts/forge.mjs make",
    "publish": "node scripts/forge.mjs publish",
    "lint": "echo \"No linting configured\""
  },
  "keywords": [
    "Speeduino",
    "ECU",
    "Tuning",
    "Electron",
    "React",
    "Dashboard",
    "Motorsport",
    "Real-time",
    "3D"
  ],
  "author": {
    "name": "sigitlutfy",
    "email": "sigitlutfy@gmail.com"
  },
  "license": "MIT",
  "devDependencies": {
    "@electron-forge/cli": "^8.0.1",
    "@electron-forge/maker-deb": "^8.0.1",
    "@electron-forge/maker-rpm": "^8.0.1",
    "@electron-forge/maker-squirrel": "^8.0.1",
    "@electron-forge/maker-zip": "^8.0.1",
    "@electron-forge/plugin-auto-unpack-natives": "^8.0.1",
    "@electron-forge/plugin-fuses": "^8.0.1",
    "@electron-forge/plugin-vite": "^8.0.1",
    "@electron/fuses": "^2.1.3",
    "@tailwindcss/postcss": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.6.1",
    "electron": "44.8.0",
    "esbuild": "^0.28.2",
    "postcss": "^8.5.30",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.4"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "buffer": "^6.0.3",
    "electron-squirrel-startup": "^1.0.1",
    "framer-motion": "^14.3.0",
    "lucide-react": "^1.58.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "serialport": "^13.0.0",
    "three": "^0.186.1",
    "uplot": "^1.6.32",
    "wouter": "^3.13.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.15"
  },
  "trustedDependencies": [
    "electron",
    "electron-winstaller",
    "serialport",
    "@serialport/bindings-cpp",
    "esbuild"
  ]
}
