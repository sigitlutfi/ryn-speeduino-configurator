{
  "name": "ryn-speeduino-configurator",
  "productName": "RYN CONFIGURATOR",
  "version": "1.0.0-alpha.1",
  "description": "Modern, high-performance tuning interface for Speeduino ECUs with real-time analytics and 3D visualization.",
  "main": ".vite/build/index.js",
  "private": false,
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "build:renderer": "vite build --config vite.renderer.config.mjs --outDir .cache/upgrade-renderer",
    "upgrade:check": "node scripts/upgrade-check.mjs",
    "upgrade:sync": "node scripts/upgrade-check.mjs --sync",
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "publish": "electron-forge publish",
    "lint": "echo \"No linting configured\""
  },
  "keywords": [
    "Speeduino",
    "ECU",
    "Tuning",
    "Electron",
    "React",
    "Dashboard",
    "Motorsport",
    "Real-time",
    "3D"
  ],
  "author": {
    "name": "sigitlutfy",
    "email": "sigitlutfy@gmail.com"
  },
  "license": "MIT",
  "devDependencies": {
    "@electron-forge/cli": "^7.11.1",
    "@electron-forge/maker-deb": "^7.11.1",
    "@electron-forge/maker-rpm": "^7.11.1",
    "@electron-forge/maker-squirrel": "^7.11.1",
    "@electron-forge/maker-zip": "^7.11.1",
    "@electron-forge/plugin-auto-unpack-natives": "^7.11.1",
    "@electron-forge/plugin-fuses": "^7.11.1",
    "@electron-forge/plugin-vite": "^7.11.1",
    "@electron/fuses": "^1.8.0",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.4.27",
    "electron": "41.0.3",
    "postcss": "^8.5.8",
    "tailwindcss": "^3.4.19",
    "vite": "^5.4.21"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.5.0",
    "buffer": "^6.0.3",
    "electron-squirrel-startup": "^1.0.1",
    "framer-motion": "^12.4.10",
    "lucide-react": "^0.477.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "serialport": "^13.0.0",
    "three": "^0.183.2",
    "uplot": "^1.6.32",
    "wouter": "^3.9.0",
    "zod": "^4.3.6",
    "zustand": "^5.0.12"
  }
}
